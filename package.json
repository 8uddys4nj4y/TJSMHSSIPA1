{
  "name": "tjs",
  "private": true,
  "version": "4.0.2",
  "description": "TJS MHSS",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint --quiet",
    "preview": "vite preview",
    "test": "vitest run tests/unit",
    "test:unit": "vitest run tests/unit",
    "test:db": "vitest run tests/db",
    "dev:backend": "node scripts/dev-db-server.mjs",
    "check:supabase": "node scripts/supabase-check.mjs",
    "provision:user": "node scripts/provision-supabase-user.mjs",
    "test:live": "vitest run --config vitest.live.config.js",
    "electron:dev": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win --config.directories.output=C:/tjs-release",
    "dist:desktop": "node scripts/build-desktop.mjs C:/tjs-release normal developer",
    "dist:chairman": "node scripts/build-desktop.mjs \"C:/TJS C\" chairman",
    "android:sync": "vite build && cap sync android",
    "android:all": "node scripts/build-android.mjs all",
    "android:open": "cap open android",
    "ios:sync": "node scripts/build-ios.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/share": "^8.0.2",
    "@electric-sql/pglite": "^0.5.8",
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "capacitor-secure-storage-plugin": "^0.13.0",
    "chart.js": "^4.5.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "happy-dom": "^21.0.4",
    "lucide-react": "^1.47.0",
    "oxlint": "^1.81.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.8",
    "react-loading-indicators": "^1.0.1",
    "read-excel-file": "^9.3.10",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "main": "electron/main.cjs",
  "author": "SanjayC",
  "build": {
    "appId": "in.tjs.mhss",
    "productName": "TJS MHSS",
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "!**/*.map",
      "!dist/**/*.md",
      "build/icon.png",
      "build/icon-dev.png",
      "build/icon-chairman.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "executableName": "TJSMHSS"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "artifactName": "TJS-MHSS-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "TJS-MHSS-Portable-${version}.${ext}"
    },
    "copyright": "SanjayC"
  }
}
